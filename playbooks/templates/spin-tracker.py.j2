#!/usr/bin/env python3
"""Spin Tracker - play history for {{ station_name }}.

A Flask web app that provides search, top plays, and recent spins
from the radio_spins.spins Postgres table populated by log-spin.py.

Managed by Ansible - do not edit manually.
"""

import psycopg2
import psycopg2.extras
from flask import Flask, request

app = Flask(__name__)

DB_PASSWORD_FILE = "/etc/radio/db-password"
DB_HOST = "{{ pg_host }}"
DB_PORT = {{ pg_port }}
DB_NAME = "radio_spins"
DB_USER = "radio_app"


def _load_password():
    with open(DB_PASSWORD_FILE) as f:
        return f.read().strip()


_DB_PASSWORD = None


def _password():
    global _DB_PASSWORD
    if _DB_PASSWORD is None:
        _DB_PASSWORD = _load_password()
    return _DB_PASSWORD

