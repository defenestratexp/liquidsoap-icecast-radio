# ---------------------------------------------------------------------------
# Database helpers
# ---------------------------------------------------------------------------

def get_db():
    return psycopg2.connect(
        host=DB_HOST,
        port=DB_PORT,
        dbname=DB_NAME,
        user=DB_USER,
        password=_password(),
        connect_timeout=5,
    )


def safe_query(query, params=()):
    try:
        conn = get_db()
        with conn, conn.cursor(cursor_factory=psycopg2.extras.RealDictCursor) as cur:
            cur.execute(query, params)
            rows = cur.fetchall()
        conn.close()
        return rows
    except Exception:
        return []


# ---------------------------------------------------------------------------
# Routes
# ---------------------------------------------------------------------------

@app.route("/")
def index():
    return top50()


@app.route("/top")
def top50():
    rows = safe_query("""
        SELECT title, artist, album,
               COUNT(*) as spins,
               MAX(played_at) as last_played
        FROM spins
        GROUP BY LOWER(title), LOWER(artist), title, artist, album
        ORDER BY spins DESC, last_played DESC
        LIMIT 50
    """)

    if not rows:
        content = '<div class="empty">No spins recorded yet.</div>'
    else:
        table_rows = ""
        for r in rows:
            table_rows += f"""<tr>
              <td>{_esc(r["title"])}</td>
              <td>{_esc(r["artist"])}</td>
              <td>{_esc(r["album"])}</td>
              <td>{r["spins"]}</td>
              <td>{_fmt_time(r["last_played"])}</td>
            </tr>"""
        content = f"""
        <div class="section-label">Top 50 Most Played</div>
        <table>
          <tr><th>Song</th><th>Artist</th><th>Album</th><th>Spins</th><th>Last Played</th></tr>
          {table_rows}
        </table>"""

    return page("Top 50", "top", content)


@app.route("/recent")
def recent():
    rows = safe_query("""
        SELECT title, artist, album, show_name, played_at
        FROM spins
        ORDER BY played_at DESC
        LIMIT 50
    """)

    if not rows:
        content = '<div class="empty">No spins recorded yet.</div>'
    else:
        table_rows = ""
        for r in rows:
            table_rows += f"""<tr>
              <td>{_esc(r["title"])}</td>
              <td>{_esc(r["artist"])}</td>
              <td>{_esc(r["album"])}</td>
              <td>{_esc(r["show_name"])}</td>
              <td>{_fmt_time(r["played_at"])}</td>
            </tr>"""
        content = f"""
        <div class="section-label">Recent Plays</div>
        <table>
          <tr><th>Song</th><th>Artist</th><th>Album</th><th>Show</th><th>Played At</th></tr>
          {table_rows}
        </table>"""

    return page("Recent Plays", "recent", content)


@app.route("/search")
def search():
    q = request.args.get("q", "").strip()

    search_form = """
    <div class="search-box">
      <form action="/stats/search" method="get">
        <input type="text" name="q" placeholder="Search by song, artist, or album..." value="{q}" autofocus>
        <button type="submit">Search</button>
      </form>
    </div>
    """.format(q=_esc(q))

    if not q:
        return page("Search", "search", search_form + '<div class="empty">Enter a search term above.</div>')

    like = f"%{q}%"
    rows = safe_query("""
        SELECT title, artist, album,
               COUNT(*) as spins,
               MAX(played_at) as last_played
        FROM spins
        WHERE title ILIKE %s
           OR artist ILIKE %s
           OR album ILIKE %s
        GROUP BY LOWER(title), LOWER(artist), title, artist, album
        ORDER BY spins DESC, last_played DESC
        LIMIT 100
    """, (like, like, like))

    if not rows:
        result = f'<div class="empty">No results for "{_esc(q)}".</div>'
    else:
        table_rows = ""
        for r in rows:
            table_rows += f"""<tr>
              <td>{_esc(r["title"])}</td>
              <td>{_esc(r["artist"])}</td>
              <td>{_esc(r["album"])}</td>
              <td>{r["spins"]}</td>
              <td>{_fmt_time(r["last_played"])}</td>
            </tr>"""
        result = f"""
        <div class="section-label">Results for "{_esc(q)}" ({len(rows)} found)</div>
        <table>
          <tr><th>Song</th><th>Artist</th><th>Album</th><th>Spins</th><th>Last Played</th></tr>
          {table_rows}
        </table>"""

    return page("Search", "search", search_form + result)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _esc(s):
    """Escape HTML entities."""
    if not s:
        return ""
    return (
        str(s)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def _fmt_time(value):
    """Format a datetime or ISO string for display as 'YYYY-MM-DD HH:MM:SS'."""
    if not value:
        return ""
    try:
        return value.strftime("%Y-%m-%d %H:%M:%S")
    except AttributeError:
        s = str(value).replace("T", " ")
        if "." in s:
            s = s[: s.index(".")]
        return s


